<section class="sec services" id="services" aria-labelledby="svc-h">
    <div class="screen">
      <div class="head" data-k="s-head" data-snap>
        <p class="sub" data-reveal>{{ sitedata.services.p_1 }}</p>
        <h2 id="svc-h" data-reveal style="--d:.08s"><span>{{ sitedata.services.span_2 }}</span> <span>{{ sitedata.services.span_3 }}</span> <span>{{ sitedata.services.span_4 }}</span></h2>
      </div>
      <a class="b btn cta" href="#contact" data-k="s-cta" data-rows="1">{{ sitedata.services.a_5 }}</a>
      <div class="b rot" data-k="rot" data-rows="5" data-rot>
        <div class="rot-sq" data-rot-squares></div>
        <p class="rot-w"><span class="rot-w1" data-rot-a>{{ sitedata.services.span_6 }}</span><span class="rot-w2" data-rot-b>{{ sitedata.services.span_7 }}</span></p>
        <p class="rot-desc" data-rot-d>{{ sitedata.services.p_8 }}</p>
      </div>
      <div class="b s-orb" data-k="s-orb" data-rows="4" data-orb="sphere" data-orb-color="amber" data-orb-scale=".34"><span class="mono" aria-hidden="true">{{ sitedata.services.span_9 }}</span></div>
      <div class="stats">
        <div class="b st st-txt" data-k="st">{{ sitedata.services.div_10_html | safe }}</div>
        <div class="b st" data-k="st"><p class="num"><span data-count="40">{{ sitedata.services.span_11 }}</span>+</p><p class="label">{{ sitedata.services.p_12 }}</p></div>
        <div class="b st" data-k="st"><p class="num"><span data-count="9">{{ sitedata.services.span_13 }}</span></p><p class="label">{{ sitedata.services.p_14 }}</p></div>
        <div class="b st" data-k="st"><p class="num"><span data-count="98">{{ sitedata.services.span_15 }}</span>%</p><p class="label">{{ sitedata.services.p_16 }}</p></div>
      </div>
      <div class="quotes" data-k="quotes" data-rows="3" data-slide aria-label="What clients say">
        <div class="track">
          <figure class="q"><blockquote>{{ sitedata.services.blockquote_17 }}</blockquote><figcaption>{{ sitedata.services.figcaption_18_html | safe }}</figcaption></figure>
          <figure class="q"><blockquote>{{ sitedata.services.blockquote_19 }}</blockquote><figcaption>{{ sitedata.services.figcaption_20_html | safe }}</figcaption></figure>
          <figure class="q"><blockquote>{{ sitedata.services.blockquote_21 }}</blockquote><figcaption>{{ sitedata.services.figcaption_22_html | safe }}</figcaption></figure>
          <figure class="q"><blockquote>{{ sitedata.services.blockquote_23 }}</blockquote><figcaption>{{ sitedata.services.figcaption_24_html | safe }}</figcaption></figure>
          <figure class="q"><blockquote>{{ sitedata.services.blockquote_25 }}</blockquote><figcaption>{{ sitedata.services.figcaption_26_html | safe }}</figcaption></figure>
        </div>
      </div>
    </div>
  </section>
